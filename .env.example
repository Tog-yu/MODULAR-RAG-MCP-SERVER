# Modular RAG MCP Server - Environment Configuration
# Copy this file to .env and fill in your API keys / customize as needed.
# Source it before running: source .env

# --- OpenAI ---
# Used when llm.provider=openai / embedding.provider=openai / vision_llm.provider=openai
export OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"

# --- Azure OpenAI ---
# Used when llm.provider=azure / embedding.provider=azure / vision_llm.provider=azure
export AZURE_OPENAI_API_KEY="YOUR_AZURE_API_KEY_HERE"
export AZURE_OPENAI_ENDPOINT="https://YOUR_ENDPOINT.openai.azure.com/"

# --- DeepSeek ---
# Used when llm.provider=deepseek
export DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY_HERE"

# --- Ollama ---
# Used when llm.provider=ollama / embedding.provider=ollama / vision_llm.provider=ollama
export OLLAMA_BASE_URL="http://localhost:11434"
